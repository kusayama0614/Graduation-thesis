# ==================== Flask 設定 ====================
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=dev-secret-key-change-in-production

# ==================== データベース ====================
DATABASE_URL=sqlite:///graduation_system.db

# ==================== Firebase / Firestore ====================
# Firestore を使う場合は、下記のいずれかを設定してください。
# 1. GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# 2. FIREBASE_CREDENTIALS_JSON={...service account json...}
GOOGLE_APPLICATION_CREDENTIALS="./graduation-thesis-69856-firebase-adminsdk-fbsvc-371e4925b3.json"
# ==================== Google Gemini ====================
GOOGLE_API_KEY=AQ.Ab8RN6JlFEEoIujI1IZ-0uMIFCwKvvLfofaduj5bUpPwS-KA9Q
GOOGLE_MODEL=gemini-2.5-flash

# ==================== ポート ====================
PORT=5002

# ==================== セッション ====================
SESSION_TYPE=filesystem
PERMANENT_SESSION_LIFETIME=3600

# ==================== ファイルアップロード ====================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

# ==================== Langchain ====================
LANGCHAIN_API_KEY=optional
LANGCHAIN_TRACING_V2=false
