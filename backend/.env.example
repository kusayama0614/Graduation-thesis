# ==================== Flask 設定 ====================
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=your-secret-key-change-in-production

# ==================== データベース ====================
DATABASE_URL=sqlite:///graduation_system.db
# PostgreSQL の場合: postgresql://user:password@localhost:5432/graduation_db

# ==================== Firebase / Firestore ====================
# Firestore を使う場合は、下記のいずれかを設定してください。
# 1. GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# 2. FIREBASE_CREDENTIALS_JSON={...service account json...}
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CREDENTIALS_JSON=

# ==================== OpenAI ====================
OPENAI_API_KEY=your-openai-api-key

# ==================== セッション ====================
SESSION_TYPE=filesystem
PERMANENT_SESSION_LIFETIME=3600

# ==================== ファイルアップロード ====================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800  # 50MB

# ==================== Langchain ====================
LANGCHAIN_API_KEY=optional-for-tracing
LANGCHAIN_TRACING_V2=false
