# ==================== Flask 設定 ====================
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=your-secret-key-change-in-production

# ==================== データベース ====================
DATABASE_URL=sqlite:///graduation_system.db
# PostgreSQL の場合: postgresql://user:password@localhost:5432/graduation_db

# ==================== Firebase / Firestore ====================
# Firestore を使う場合は、下記のいずれかを設定してください。
# 1. GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# 2. FIREBASE_CREDENTIALS_JSON={...service account json...}
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CREDENTIALS_JSON=

# ==================== Gemini（LLM） ====================
# Google AI Studio で発行した API キー（GOOGLE_API_KEY という名前でも可）
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# 任意: 思考の深さ（low にすると速く安くなる。未設定ならモデルの既定）
GEMINI_THINKING_LEVEL=
# 解説どうしの意味の類似度（卒論 5.5節）に使う埋め込みモデル
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ==================== セッション ====================
SESSION_TYPE=filesystem
PERMANENT_SESSION_LIFETIME=3600

# ==================== ファイルアップロード ====================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800  # 50MB

# ==================== Langchain ====================
LANGCHAIN_API_KEY=optional-for-tracing
LANGCHAIN_TRACING_V2=false

# 演習プリントの一括取り込み（任意）
# BULK_READ_CONCURRENCY=4        # 見出しの読み取りを同時に行う数
# ANSWER_SHEET_CONCURRENCY=2     # 答案の OCR・自動採点を同時に行う数
