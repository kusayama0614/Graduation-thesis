        {"id": "discriminant_setup", "label": "判別式に代入する係数の読み取りと立式", "evidence": "No.1（係数の読み取りの誤り3件，−4(−m+3)の展開の誤り4件）"},
        {"id": "discriminant_sign", "label": "判別式の符号と実数解の個数・共有点の個数の対応", "evidence": "No.1（個数の誤判定5件），No.2"},
